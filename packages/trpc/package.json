{
  "name": "@barberlab/trpc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts",
      "default": "./src/browser.ts"
    }
  },
  "dependencies": {
    "@barberlab/db": "workspace:*",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "date-fns": "^4.1.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm --dts"
  },
  "devDependencies": {
    "@barberlab/config": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
